/* runtime/routines.def
 * The runtime contract: every routine generated code may call.
 * Each target runtime under runtime/<arch>/ must export all of these.
 * Usage: #define RUNTIME_ROUTINE(name) ... then #include "routines.def"
 */
RUNTIME_ROUTINE(runtime_init)
RUNTIME_ROUTINE(runtime_exit)
RUNTIME_ROUTINE(runtime_display_string)
RUNTIME_ROUTINE(runtime_display_numeric)
RUNTIME_ROUTINE(runtime_display_var_string)
RUNTIME_ROUTINE(runtime_display_fill)
RUNTIME_ROUTINE(runtime_display_newline)
RUNTIME_ROUTINE(runtime_move_alphanum)
RUNTIME_ROUTINE(runtime_move_numeric)
RUNTIME_ROUTINE(runtime_move_fill)
RUNTIME_ROUTINE(runtime_accept)
RUNTIME_ROUTINE(runtime_accept_numeric)
RUNTIME_ROUTINE(runtime_num_load)
RUNTIME_ROUTINE(runtime_num_store)
RUNTIME_ROUTINE(runtime_num_rescale)
RUNTIME_ROUTINE(runtime_num_mul)
RUNTIME_ROUTINE(runtime_num_div)
RUNTIME_ROUTINE(runtime_compare_alnum)
RUNTIME_ROUTINE(runtime_compare_fill)
RUNTIME_ROUTINE(runtime_class_test)
RUNTIME_ROUTINE(runtime_replicate)
RUNTIME_ROUTINE(runtime_move_pattern)
RUNTIME_ROUTINE(runtime_compare_pattern)
RUNTIME_ROUTINE(runtime_file_open)
RUNTIME_ROUTINE(runtime_file_close)
RUNTIME_ROUTINE(runtime_file_read)
RUNTIME_ROUTINE(runtime_file_write)
RUNTIME_ROUTINE(runtime_file_rewrite)
RUNTIME_ROUTINE(runtime_edit_numeric)
RUNTIME_ROUTINE(runtime_edit_alnum)
RUNTIME_ROUTINE(runtime_deedit)
RUNTIME_ROUTINE(runtime_num_to_digits)
RUNTIME_ROUTINE(runtime_inspect)
