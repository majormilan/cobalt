       IDENTIFICATION DIVISION.
       PROGRAM-ID. CONDITIONS.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 A      PIC 99 VALUE 5.
       01 B      PIC 99 VALUE 10.
       01 C      PIC S99 VALUE -3.
       01 NAME   PIC X(5) VALUE "Smith".
       01 CODE-X PIC X(3) VALUE "123".
       01 UPPER  PIC X(4) VALUE "ABCD".
       01 LOWER  PIC X(4) VALUE "ab d".
       01 MIXED  PIC X(4) VALUE "A1B2".
       01 SD     PIC S99 VALUE -12.
       01 HV     PIC X(3) VALUE HIGH-VALUES.
       PROCEDURE DIVISION.
       MAIN-PARA.
           IF A < B AND B < 20 DISPLAY "1 AND" END-IF.
           IF A > B OR C < 0 DISPLAY "2 OR" END-IF.
           IF NOT A > B DISPLAY "3 NOT" END-IF.
           IF A IS GREATER THAN 4 AND LESS THAN 6 DISPLAY "4 ABBREV" END-IF.
           IF A = 1 OR 3 OR 5 DISPLAY "5 ABBREV-OBJ" END-IF.
           IF A IS NOT EQUAL TO B DISPLAY "6 NOT EQUAL" END-IF.
           IF A GREATER THAN OR EQUAL TO 5 DISPLAY "7 GE" END-IF.
           IF (A + B) * 2 = 30 DISPLAY "8 EXPR" END-IF.
           IF (A < B OR A > 50) AND C NEGATIVE DISPLAY "9 PAREN" END-IF.
           IF C IS NOT POSITIVE DISPLAY "10 SIGN" END-IF.
           IF A - 5 IS ZERO DISPLAY "11 ZERO" END-IF.
           IF CODE-X NUMERIC DISPLAY "12 NUMERIC" END-IF.
           IF NAME NUMERIC DISPLAY "X" ELSE DISPLAY "13 NOT NUMERIC" END-IF.
           IF NAME ALPHABETIC DISPLAY "14 ALPHABETIC" END-IF.
           IF UPPER IS ALPHABETIC-UPPER DISPLAY "15 UPPER" END-IF.
           IF LOWER ALPHABETIC-LOWER DISPLAY "16 LOWER" END-IF.
           IF MIXED IS NOT ALPHABETIC DISPLAY "17 MIXED" END-IF.
           IF SD NUMERIC DISPLAY "18 SIGNED NUMERIC" END-IF.
           IF HV = HIGH-VALUES DISPLAY "19 HIGH" END-IF.
           IF NAME > SPACES DISPLAY "20 SPACES" END-IF.
           IF NAME = "Smith" DISPLAY "21 STRING" END-IF.
           IF A NOT < 5 DISPLAY "22 NOT LT" END-IF.
           IF A = 5 AND NOT = 6 DISPLAY "23 AND NOT ABBREV" END-IF.
           STOP RUN.
