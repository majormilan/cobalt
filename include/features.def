/* include/features.def
 * The language elements that differ between COBOL standards and vendor
 * dialects: which standards contain each, which extension sets (-fext)
 * provide it, and whether Cobalt implements it. diag_feature() decides from
 * this table and the compile's settings what a use of it gives: nothing, an
 * extension warning, or an error naming where the element comes from.
 *
 * FEATURE(id, context, word, text, standards, sets, implemented, origin)
 *   context, word  where the parser recognizes an element it does not
 *                  implement (LATER_*), or LATER_NONE for elements the code
 *                  names by id
 *   text           the element in messages
 *   standards      STD_2002, STD_2014: the standards that contain it
 *   sets           EXT_COMMON, EXT_IBM, EXT_GNUCOBOL, EXT_MF, EXT_COBOL2002
 *   implemented    1 if Cobalt compiles it
 *   origin         a text replacing the one built from standards and sets,
 *                  or NULL
 *
 * The common set (EXT_COMMON) is enabled by default (-X normal, relaxed).
 */

/* ── Implemented ────────────────────────────────────────────────────────── */
FEATURE(F_FREE_FORMAT, LATER_NONE, "", "Free-form reference format (-F)",
        STD_2002 | STD_2014, EXT_COMMON | EXT_GNUCOBOL | EXT_MF | EXT_COBOL2002, 1, NULL)
FEATURE(F_FLOATING_COMMENT, LATER_NONE, "", "The floating comment indicator *> (COBOL 2002)",
        STD_2002 | STD_2014, EXT_COMMON | EXT_IBM | EXT_GNUCOBOL | EXT_MF | EXT_COBOL2002, 1, NULL)
